{
  "name": "@ecommercemultivendor/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "migrate:taxonomy": "tsx src/scripts/migrate-taxonomy.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ecommercemultivendor/types": "*",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.5",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3",
    "multer": "^2.0.1",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.4.1",
    "@paypal/paypal-server-sdk": "^0.6.1",
    "pdfkit": "^0.15.1",
    "razorpay": "^2.9.5",
    "stripe": "^17.4.0",
