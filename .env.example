# ── App ──────────────────────────────────────────────────────────
APP_NAME="PHPStore - Be Vocal for Local - Digital India"
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_PORT=4000
DEFAULT_LANGUAGE=en
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

# ── MongoDB (carried over from prior local setup) ───────────────
# IMPORTANT: checkout/order/refund/POS flows use multi-document transactions
# (mongoose sessions), which MongoDB only supports on a replica set or mongos —
# a plain standalone `mongod` will fail with "Transaction numbers are only
# allowed on a replica set member or mongos". MongoDB Atlas is already a
# replica set by default. For local dev against a standalone install, either:
#   - initiate a single-node replica set (start mongod with --replSet rs0,
#     then run `rs.initiate()` once via mongosh), or
#   - point this at an Atlas (or any replica-set) connection string instead.
MONGODB_URI=mongodb://127.0.0.1:27017/v4local_marketplace
MONGODB_DB=v4local_marketplace

# ── Auth (JWT) ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
EMAIL_VERIFY_SECRET=replace-with-another-32-plus-random-string

# ── NextAuth (web app) ───────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters

# ── Internal (server-to-server, web -> api social login bridge) ──
INTERNAL_API_SECRET=replace-with-at-least-32-random-characters

# ── Social login ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Email ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=
MAIL_FROM_NAME=

# ── Payments (fill in your own keys; never commit real values here) ─
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Twilio Verify (OTP) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── File storage ──────────────────────────────────────────────────
UPLOAD_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# ── Analytics / Pixels (from legacy .env) ─────────────────────────
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-T7899BYWWM"
NEXT_PUBLIC_FACEBOOK_PAGE_ID="111931653862788"
NEXT_PUBLIC_FACEBOOK_PIXEL_ID="805504786659486"
