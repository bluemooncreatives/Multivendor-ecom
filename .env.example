# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
PORT=3000
HOST=0.0.0.0

# MongoDB (use an Atlas replica set in production for transactional checkout)
MONGODB_URI=mongodb://127.0.0.1:27017/v4local_marketplace
MONGODB_DB=v4local_marketplace
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000

# Development-only catalog fallback. Keep false in production.
ALLOW_DEMO_DATA=false

# Required only by npm run db:seed; never use these sample values in production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_SELLER_EMAIL=seller@example.com
SEED_SELLER_PASSWORD=

# Express
TRUST_PROXY_HOPS=0
API_RATE_LIMIT=180
AUTH_RATE_LIMIT=20
API_TOKEN_DAYS=30

# Optional providers. Configure only providers enabled in the admin workspace.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=V4Local
SMTP_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_FACEBOOK_PAGE_ID=
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
